# Zego API v1.5 — https://www.zegoapi.com/document/v1.5
# ขอ Token จาก Zego แล้วคัดลอกไฟล์นี้เป็น .env.local (ห้าม commit ค่าจริง)
ZEGO_API_TOKEN=

# Anthropic API — ใช้อ่าน+แปลใบเสร็จหลายภาษา (ญี่ปุ่น/จีน/อังกฤษ ฯลฯ) เป็นไทยในหน้าบันทึกค่าใช้จ่าย
# ขอ Key จาก https://console.anthropic.com/ แล้วคัดลอกไฟล์นี้เป็น .env.local (ห้าม commit ค่าจริง)
# ไม่ตั้งค่านี้ = ฟีเจอร์สแกนใบเสร็จปิดอัตโนมัติ กรอกฟอร์มเองได้ตามปกติ ไม่กระทบส่วนอื่น
ANTHROPIC_API_KEY=

# ใส่เฉพาะกรณี Key ด้านบนเป็นแบบ "identity-linked" (สมัคร/ล็อกอิน Console ด้วย Google/SSO) แล้วเจอ error
# "anthropic-workspace-id is required..." — หาได้จาก console.anthropic.com > Settings > Workspaces
# > เปิด workspace ที่จะใช้ > คัดลอก ID จาก URL (ขึ้นต้นด้วย wrkspc_)
ANTHROPIC_WORKSPACE_ID=
